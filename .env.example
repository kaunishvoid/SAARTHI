# Local development default; the SQLite file is created under instance/.
DATABASE_URL=sqlite:///saarthi.db

# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when APP_ENV=production. Never commit the generated value.
SECRET_KEY=
APP_ENV=development
SESSION_COOKIE_SECURE=false

# Crop model artifacts are loaded from this project-relative default unless overridden.
# CROP_MODEL_ARTIFACT_DIR=backend/app/ml/artifacts

# NEUTRA-BOOST artifact directory defaults to backend/app/ml/fertilizer_artifacts.
# FERTILIZER_MODEL_ARTIFACT_DIR=backend/app/ml/fertilizer_artifacts

# Optional local PostgreSQL service (docker compose up -d db).
POSTGRES_DB=saarthi
POSTGRES_USER=saarthi
POSTGRES_PASSWORD=replace-with-a-local-development-password
# To use PostgreSQL, set DATABASE_URL to a URL matching the credentials above.
# DATABASE_URL=postgresql+psycopg://saarthi:replace-with-a-local-development-password@127.0.0.1:5432/saarthi?connect_timeout=3
